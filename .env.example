# FileRoom production settings, read by docker-compose-prod.yml.
#   cp .env.example .env   and edit the three values marked CHANGE.

# --- Domain -----------------------------------------------------------------
# CHANGE: the public host name nginx serves FileRoom on (no https://, no path).
DOMAIN=fileroom.example.com

# CHANGE: host name (or IP) under which THIS server is reachable directly, for calls (STUN/TURN).
# Normally the same as DOMAIN. If DOMAIN goes through a CDN/proxy such as Cloudflare (orange cloud),
# use a DNS name that points straight at the server instead, e.g. turn.example.com (DNS only).
TURN_HOST=fileroom.example.com

# --- Calls & babyphone (coturn) ----------------------------------------------
# CHANGE: shared secret between FileRoom and coturn. Generate with: openssl rand -hex 32
TURN_SECRET=

# Only if the server's public IP is NOT configured on the server itself (home server behind a router,
# or a cloud VM with 1:1 NAT such as AWS, GCP, Azure, Oracle). Then put the public IP here.
# Check: `ip -4 addr` on the server lists the public IP -> leave empty.
TURN_EXTERNAL_IP=

# Ports to open in the firewall: TURN_PORT (udp + tcp) and TURN_MIN_PORT-TURN_MAX_PORT (udp).
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Forward babyphone alerts (already encrypted for the parent phone) to browser push services.
PUSH_RELAY=1

# --- Limits -------------------------------------------------------------------
MAX_FILE_SIZE=104857600        # per file, bytes (100 MB). nginx: client_max_body_size must be a bit larger
MAX_SHARE_SIZE=524288000       # one share from another app, bytes (500 MB)
MAX_STORAGE_SIZE=2147483648    # all rooms together on disk, bytes (2 GB)
MESSAGE_EXPIRY_HOURS=1
USER_TIMEOUT_SECONDS=60
MAX_ROOM_CODE_LENGTH=64
FILEROOM_MEM_LIMIT=256m        # RAM cap of the app container (files are on disk, not in RAM)
